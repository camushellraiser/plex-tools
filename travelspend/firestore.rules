rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validExpense(expenseId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'id', 'merchant', 'amountCents', 'category',
          'date', 'note', 'payment', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'id', 'merchant', 'amountCents', 'category',
          'date', 'note', 'payment', 'createdAt', 'updatedAt'
        ])
        && d.id == expenseId
        && d.merchant is string
        && d.merchant.size() > 0 && d.merchant.size() <= 80
        && d.amountCents is int && d.amountCents != 0
        && d.amountCents >= -100000000 && d.amountCents <= 100000000
        && d.category in [
          'shopping', 'food', 'transport', 'groceries',
          'fun', 'kids', 'hotel', 'other'
        ]
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.note is string && d.note.size() <= 300
        && d.payment in ['card', 'cash', 'other']
        && d.createdAt is int && d.updatedAt is int;
    }

    match /users/{uid}/expenses/{expenseId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validExpense(expenseId);
      allow delete: if isOwner(uid);
    }
  }
}
